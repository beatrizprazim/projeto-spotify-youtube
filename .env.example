# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Modo: "simulado" (dados gerados, sem chaves) ou "real" (usa as APIs)
MODO=simulado

# Banco (no Docker o host é "db"; rodando local sem Docker use localhost)
DATABASE_URL=postgresql+psycopg2://etl:etl@db:5432/tendencias

# Spotify (https://developer.spotify.com/dashboard)
# Desde fev/2026 o dono do app em Development Mode precisa ter Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (Google Cloud Console > APIs & Services > Credentials > API key)
YOUTUBE_API_KEY=

# Países analisados (códigos ISO-2, os mesmos dos CSVs do Spotify Charts)
PAISES=BR,US,MX,AR,ES,JP

# Pasta com os CSVs baixados de charts.spotify.com (Top 50 semanal por país)
CHARTS_DIR=data/charts

# Intervalo mínimo entre chamadas às APIs (segundos) - controle de rate limiting
INTERVALO_REQUISICOES=0.2
